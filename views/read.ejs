<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>All Users</title>
    <script src="https://cdn.tailwindcss.com"></script>
</head>
<body class="bg-zinc-900 text-white p-10">
    <div class="max-w-6xl mx-auto">
        <a class="text-blue-500" href="/">Back to Home</a>
        <h1 class="text-3xl mt-3 mb-5">All Users</h1>

        <% if (users.length === 0) { %>
            <p class="text-zinc-400">No users yet</p>
        <% } else { %>
            <div class="flex flex-wrap gap-5">
                <% users.forEach(function(user) { %>
                    <div class="w-72 p-4 bg-zinc-800 rounded-lg">
                        <div class="w-full h-72 bg-zinc-700 rounded-lg overflow-hidden">
                            <img class="w-full h-full object-cover" src="<%= user.image %>" alt="<%= user.name %>">
                        </div>
                        <h3 class="text-xl mt-3"><%= user.name %></h3>
                        <h5 class="text-zinc-400"><%= user.email %></h5>
                        <div class="flex gap-3 mt-3">
                            <a class="text-blue-400" href="/edit/<%= user._id %>">Edit User</a>
                            <a class="text-red-500" href="/delete/<%= user._id %>">Delete User</a>
                        </div>
                    </div>
                <% }); %>
            </div>
        <% } %>
    </div>
</body>
</html>
