<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>UserDash — Create User</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800;900&display=swap" rel="stylesheet">
    <style>
        * { font-family: 'Inter', sans-serif; }

        body {
            background: #050508;
            overflow-x: hidden;
        }

        /* Animated background orbs */
        .orb {
            position: fixed;
            border-radius: 50%;
            filter: blur(80px);
            animation: float 8s ease-in-out infinite;
            pointer-events: none;
            z-index: 0;
        }
        .orb-1 { width: 500px; height: 500px; background: rgba(99,102,241,0.12); top: -200px; right: -100px; animation-delay: 0s; }
        .orb-2 { width: 400px; height: 400px; background: rgba(59,130,246,0.1); bottom: -150px; left: -100px; animation-delay: 3s; }
        .orb-3 { width: 300px; height: 300px; background: rgba(168,85,247,0.08); top: 50%; left: 50%; animation-delay: 6s; }

        @keyframes float {
            0%, 100% { transform: translateY(0px) scale(1); }
            50% { transform: translateY(-30px) scale(1.05); }
        }

        /* Grid pattern */
        .grid-pattern {
            position: fixed;
            inset: 0;
            background-image:
                linear-gradient(rgba(255,255,255,0.02) 1px, transparent 1px),
                linear-gradient(90deg, rgba(255,255,255,0.02) 1px, transparent 1px);
            background-size: 50px 50px;
            pointer-events: none;
            z-index: 0;
        }

        /* Glass card */
        .glass-card {
            background: rgba(255,255,255,0.03);
            backdrop-filter: blur(20px);
            border: 1px solid rgba(255,255,255,0.08);
            box-shadow: 0 0 0 1px rgba(255,255,255,0.03), 0 32px 64px rgba(0,0,0,0.5), inset 0 1px 0 rgba(255,255,255,0.06);
        }

        /* Input styles */
        .input-wrap { position: relative; }
        .fancy-input {
            width: 100%;
            background: rgba(255,255,255,0.04);
            border: 1px solid rgba(255,255,255,0.08);
            border-radius: 14px;
            padding: 14px 16px 14px 44px;
            color: white;
            font-size: 14px;
            outline: none;
            transition: all 0.3s cubic-bezier(0.4,0,0.2,1);
        }
        .fancy-input::placeholder { color: rgba(255,255,255,0.2); }
        .fancy-input:focus {
            background: rgba(99,102,241,0.08);
            border-color: rgba(99,102,241,0.5);
            box-shadow: 0 0 0 4px rgba(99,102,241,0.08), 0 0 20px rgba(99,102,241,0.1);
        }
        .input-icon {
            position: absolute;
            left: 14px;
            top: 50%;
            transform: translateY(-50%);
            color: rgba(255,255,255,0.25);
            transition: color 0.3s;
        }
        .input-wrap:focus-within .input-icon { color: rgba(99,102,241,0.7); }

        /* Submit button */
        .submit-btn {
            background: linear-gradient(135deg, #6366f1 0%, #8b5cf6 50%, #3b82f6 100%);
            background-size: 200% 200%;
            animation: gradientShift 4s ease infinite;
            border: none;
            border-radius: 14px;
            padding: 15px;
            color: white;
            font-weight: 700;
            font-size: 15px;
            width: 100%;
            cursor: pointer;
            transition: all 0.3s;
            position: relative;
            overflow: hidden;
            box-shadow: 0 8px 32px rgba(99,102,241,0.35);
        }
        .submit-btn::before {
            content: '';
            position: absolute;
            inset: 0;
            background: linear-gradient(135deg, rgba(255,255,255,0.15), transparent);
            opacity: 0;
            transition: opacity 0.3s;
        }
        .submit-btn:hover::before { opacity: 1; }
        .submit-btn:hover { transform: translateY(-2px); box-shadow: 0 16px 48px rgba(99,102,241,0.45); }
        .submit-btn:active { transform: scale(0.98) translateY(0); }

        @keyframes gradientShift {
            0% { background-position: 0% 50%; }
            50% { background-position: 100% 50%; }
            100% { background-position: 0% 50%; }
        }

        /* Navbar */
        .navbar {
            background: rgba(5,5,8,0.8);
            backdrop-filter: blur(24px);
            border-bottom: 1px solid rgba(255,255,255,0.05);
        }

        /* Badge */
        .badge {
            display: inline-flex;
            align-items: center;
            gap: 6px;
            background: rgba(99,102,241,0.1);
            border: 1px solid rgba(99,102,241,0.2);
            color: #a5b4fc;
            font-size: 11px;
            font-weight: 600;
            padding: 5px 12px;
            border-radius: 100px;
            letter-spacing: 0.05em;
            text-transform: uppercase;
        }

        /* Fade in animation */
        .fade-up {
            animation: fadeUp 0.6s cubic-bezier(0.4,0,0.2,1) forwards;
            opacity: 0;
        }
        @keyframes fadeUp {
            from { opacity: 0; transform: translateY(24px); }
            to { opacity: 1; transform: translateY(0); }
        }
        .delay-1 { animation-delay: 0.1s; }
        .delay-2 { animation-delay: 0.2s; }
        .delay-3 { animation-delay: 0.3s; }
        .delay-4 { animation-delay: 0.4s; }

        /* Thumbnail preview */
        #thumb-preview {
            position: absolute;
            right: 12px;
            top: 50%;
            transform: translateY(-50%);
            width: 32px;
            height: 32px;
            border-radius: 8px;
            object-fit: cover;
            border: 1px solid rgba(255,255,255,0.15);
            display: none;
            transition: all 0.3s;
        }
    </style>
</head>
<body class="text-white min-h-screen relative">

    <div class="grid-pattern"></div>
    <div class="orb orb-1"></div>
    <div class="orb orb-2"></div>
    <div class="orb orb-3"></div>

    <!-- Navbar -->
    <nav class="navbar px-6 lg:px-10 py-4 flex items-center justify-between sticky top-0 z-50">
        <div class="flex items-center gap-3">
            <div class="w-9 h-9 rounded-xl flex items-center justify-center font-black text-sm"
                style="background: linear-gradient(135deg, #6366f1, #8b5cf6);">
                U
            </div>
            <div>
                <span class="font-bold text-base tracking-tight">UserDash</span>
                <span class="text-zinc-600 text-xs ml-2 hidden sm:inline">v2.0</span>
            </div>
        </div>
        <a href="/read"
            class="flex items-center gap-2 text-zinc-400 hover:text-white text-sm font-medium transition-all duration-200 border border-white/[0.07] hover:border-white/20 px-4 py-2 rounded-xl hover:bg-white/[0.04]">
            <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 20h5v-2a4 4 0 00-4-4H6a4 4 0 00-4 4v2h5M12 12a4 4 0 100-8 4 4 0 000 8z"/></svg>
            View All Users
        </a>
    </nav>

    <!-- Main Content -->
    <div class="relative z-10 flex items-center justify-center min-h-[calc(100vh-65px)] px-4 py-16">
        <div class="w-full max-w-md">

            <!-- Title -->
            <div class="text-center mb-8 fade-up">
                <div class="badge mb-5">
                    <span class="w-1.5 h-1.5 bg-indigo-400 rounded-full animate-pulse"></span>
                    New Entry
                </div>
                <h1 class="text-4xl font-black tracking-tight leading-tight">
                    Create a
                    <span style="background: linear-gradient(135deg, #6366f1, #a78bfa, #3b82f6); -webkit-background-clip: text; -webkit-text-fill-color: transparent; background-clip: text;">
                        New User
                    </span>
                </h1>
                <p class="text-zinc-500 mt-3 text-sm leading-relaxed">
                    Fill in the details below to add a new user<br>to your dashboard.
                </p>
            </div>

            <!-- Form Card -->
            <div class="glass-card rounded-3xl p-8 fade-up delay-1">
                <form action="/create" method="post" class="flex flex-col gap-5">

                    <!-- Name -->
                    <div class="fade-up delay-1">
                        <label class="block text-[11px] font-bold text-zinc-500 uppercase tracking-widest mb-2">Full Name</label>
                        <div class="input-wrap">
                            <span class="input-icon">
                                <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"/></svg>
                            </span>
                            <input class="fancy-input" type="text" name="name" placeholder="e.g. John Doe" required>
                        </div>
                    </div>

                    <!-- Email -->
                    <div class="fade-up delay-2">
                        <label class="block text-[11px] font-bold text-zinc-500 uppercase tracking-widest mb-2">Email Address</label>
                        <div class="input-wrap">
                            <span class="input-icon">
                                <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/></svg>
                            </span>
                            <input class="fancy-input" type="email" name="email" placeholder="john@example.com" required>
                        </div>
                    </div>

                    <!-- Image URL -->
                    <div class="fade-up delay-3">
                        <label class="block text-[11px] font-bold text-zinc-500 uppercase tracking-widest mb-2">Profile Image URL</label>
                        <div class="input-wrap">
                            <span class="input-icon">
                                <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z"/></svg>
                            </span>
                            <input id="img-input" class="fancy-input" style="padding-right: 52px;" type="text" name="imageurl" placeholder="https://example.com/photo.jpg" required>
                            <img id="thumb-preview" src="" alt="preview">
                        </div>
                    </div>

                    <!-- Submit -->
                    <div class="fade-up delay-4 mt-1">
                        <button type="submit" class="submit-btn">
                            Create User →
                        </button>
                    </div>

                </form>
            </div>

            <!-- Footer hint -->
            <p class="text-center text-zinc-700 text-xs mt-6 fade-up delay-4">
                UserDash &nbsp;·&nbsp; Built with Node.js &amp; MongoDB
            </p>

        </div>
    </div>

    <script>
        const imgInput = document.getElementById('img-input');
        const thumb = document.getElementById('thumb-preview');
        imgInput.addEventListener('input', () => {
            if (imgInput.value.startsWith('http')) {
                thumb.src = imgInput.value;
                thumb.style.display = 'block';
            } else {
                thumb.style.display = 'none';
            }
        });
    </script>
</body>
</html>
