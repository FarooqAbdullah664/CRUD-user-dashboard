<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>User Dashboard</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
    <style> body { font-family: 'Inter', sans-serif; } </style>
</head>
<body class="bg-[#0f0f13] text-white min-h-screen">

    <!-- Navbar -->
    <nav class="border-b border-white/10 px-8 py-4 flex items-center justify-between">
        <div class="flex items-center gap-2">
            <div class="w-8 h-8 bg-blue-600 rounded-lg flex items-center justify-center text-sm font-bold">U</div>
            <span class="font-semibold text-lg">UserDash</span>
        </div>
        <a href="/read" class="flex items-center gap-2 bg-white/10 hover:bg-white/20 transition px-4 py-2 rounded-lg text-sm font-medium">
            <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 20h5v-2a4 4 0 00-4-4H6a4 4 0 00-4 4v2h5M12 12a4 4 0 100-8 4 4 0 000 8z"/></svg>
            View All Users
        </a>
    </nav>

    <!-- Main -->
    <div class="flex items-center justify-center min-h-[calc(100vh-65px)] px-4">
        <div class="w-full max-w-md">

            <!-- Card -->
            <div class="bg-[#1a1a24] border border-white/10 rounded-2xl p-8 shadow-2xl">
                <div class="mb-6">
                    <h1 class="text-2xl font-bold">Create New User</h1>
                    <p class="text-zinc-400 text-sm mt-1">Fill in the details to add a user</p>
                </div>

                <form action="/create" method="post" class="flex flex-col gap-4">

                    <div class="flex flex-col gap-1">
                        <label class="text-xs font-medium text-zinc-400 uppercase tracking-wider">Full Name</label>
                        <input
                            class="px-4 py-3 bg-white/5 border border-white/10 rounded-xl outline-none focus:border-blue-500 focus:bg-white/10 transition text-sm placeholder-zinc-600"
                            type="text" name="name" placeholder="John Doe" required>
                    </div>

                    <div class="flex flex-col gap-1">
                        <label class="text-xs font-medium text-zinc-400 uppercase tracking-wider">Email Address</label>
                        <input
                            class="px-4 py-3 bg-white/5 border border-white/10 rounded-xl outline-none focus:border-blue-500 focus:bg-white/10 transition text-sm placeholder-zinc-600"
                            type="email" name="email" placeholder="john@example.com" required>
                    </div>

                    <div class="flex flex-col gap-1">
                        <label class="text-xs font-medium text-zinc-400 uppercase tracking-wider">Profile Image URL</label>
                        <input
                            class="px-4 py-3 bg-white/5 border border-white/10 rounded-xl outline-none focus:border-blue-500 focus:bg-white/10 transition text-sm placeholder-zinc-600"
                            type="text" name="imageurl" placeholder="https://example.com/photo.jpg" required>
                    </div>

                    <button type="submit"
                        class="mt-2 w-full bg-blue-600 hover:bg-blue-500 active:scale-95 transition-all py-3 rounded-xl font-semibold text-sm shadow-lg shadow-blue-600/20">
                        Create User
                    </button>

                </form>
            </div>

        </div>
    </div>

</body>
</html>
