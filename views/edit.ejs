<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>UserDash — Edit User</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800;900&display=swap" rel="stylesheet">
    <style>
        * { font-family: 'Inter', sans-serif; }
        body { background: #050508; overflow-x: hidden; }

        .orb {
            position: fixed; border-radius: 50%; filter: blur(80px);
            animation: float 8s ease-in-out infinite; pointer-events: none; z-index: 0;
        }
        .orb-1 { width: 500px; height: 500px; background: rgba(168,85,247,0.1); top: -150px; right: -100px; }
        .orb-2 { width: 400px; height: 400px; background: rgba(59,130,246,0.08); bottom: -150px; left: -100px; animation-delay: 4s; }
        @keyframes float {
            0%, 100% { transform: translateY(0) scale(1); }
            50% { transform: translateY(-25px) scale(1.04); }
        }

        .grid-pattern {
            position: fixed; inset: 0;
            background-image: linear-gradient(rgba(255,255,255,0.015) 1px, transparent 1px), linear-gradient(90deg, rgba(255,255,255,0.015) 1px, transparent 1px);
            background-size: 60px 60px; pointer-events: none; z-index: 0;
        }

        .navbar { background: rgba(5,5,8,0.85); backdrop-filter: blur(24px); border-bottom: 1px solid rgba(255,255,255,0.05); }

        /* Preview card */
        .preview-card {
            background: rgba(255,255,255,0.025);
            border: 1px solid rgba(255,255,255,0.07);
            border-radius: 20px;
            padding: 16px;
            display: flex;
            align-items: center;
            gap: 16px;
        }

        .avatar-wrap {
            position: relative;
            flex-shrink: 0;
        }
        .avatar-img {
            width: 72px; height: 72px;
            border-radius: 18px;
            object-fit: cover;
            border: 2px solid rgba(168,85,247,0.4);
            box-shadow: 0 0 20px rgba(168,85,247,0.2);
        }
        .online-dot {
            position: absolute; bottom: -2px; right: -2px;
            width: 14px; height: 14px;
            background: #22c55e;
            border-radius: 50%;
            border: 2px solid #050508;
            box-shadow: 0 0 8px rgba(34,197,94,0.5);
        }

        /* Glass form card */
        .glass-card {
            background: rgba(255,255,255,0.025);
            backdrop-filter: blur(20px);
            border: 1px solid rgba(255,255,255,0.07);
            border-radius: 24px;
            box-shadow: 0 32px 64px rgba(0,0,0,0.5), inset 0 1px 0 rgba(255,255,255,0.05);
        }

        .fancy-input {
            width: 100%;
            background: rgba(255,255,255,0.04);
            border: 1px solid rgba(255,255,255,0.08);
            border-radius: 14px;
            padding: 14px 16px 14px 44px;
            color: white;
            font-size: 14px;
            outline: none;
            transition: all 0.3s;
        }
        .fancy-input::placeholder { color: rgba(255,255,255,0.2); }
        .fancy-input:focus {
            background: rgba(168,85,247,0.08);
            border-color: rgba(168,85,247,0.45);
            box-shadow: 0 0 0 4px rgba(168,85,247,0.08);
        }
        .input-wrap { position: relative; }
        .input-icon {
            position: absolute; left: 14px; top: 50%; transform: translateY(-50%);
            color: rgba(255,255,255,0.25); transition: color 0.3s;
        }
        .input-wrap:focus-within .input-icon { color: rgba(168,85,247,0.7); }

        /* Buttons */
        .btn-cancel {
            flex: 1; text-align: center;
            background: rgba(255,255,255,0.04);
            border: 1px solid rgba(255,255,255,0.08);
            color: #a1a1aa;
            padding: 14px; border-radius: 14px;
            font-weight: 600; font-size: 14px;
            transition: all 0.2s; display: block;
        }
        .btn-cancel:hover { background: rgba(255,255,255,0.08); color: white; }

        .btn-save {
            flex: 1;
            background: linear-gradient(135deg, #8b5cf6, #6366f1);
            background-size: 200% 200%;
            animation: gradientShift 4s ease infinite;
            border: none; border-radius: 14px;
            padding: 14px; color: white;
            font-weight: 700; font-size: 14px;
            cursor: pointer;
            box-shadow: 0 8px 28px rgba(139,92,246,0.35);
            transition: all 0.3s;
        }
        .btn-save:hover { transform: translateY(-2px); box-shadow: 0 14px 40px rgba(139,92,246,0.45); }
        .btn-save:active { transform: scale(0.98); }

        @keyframes gradientShift {
            0% { background-position: 0% 50%; }
            50% { background-position: 100% 50%; }
            100% { background-position: 0% 50%; }
        }

        .fade-up { animation: fadeUp 0.5s cubic-bezier(0.4,0,0.2,1) forwards; opacity: 0; }
        @keyframes fadeUp { from { opacity: 0; transform: translateY(20px); } to { opacity: 1; transform: translateY(0); } }
        .d1 { animation-delay: 0.05s; } .d2 { animation-delay: 0.1s; }
        .d3 { animation-delay: 0.15s; } .d4 { animation-delay: 0.2s; }

        .editing-badge {
            display: inline-flex; align-items: center; gap: 5px;
            background: rgba(168,85,247,0.1); border: 1px solid rgba(168,85,247,0.2);
            color: #d8b4fe; font-size: 11px; font-weight: 600;
            padding: 4px 10px; border-radius: 100px;
        }
    </style>
</head>
<body class="text-white min-h-screen">

    <div class="grid-pattern"></div>
    <div class="orb orb-1"></div>
    <div class="orb orb-2"></div>

    <!-- Navbar -->
    <nav class="navbar px-6 lg:px-10 py-4 flex items-center justify-between sticky top-0 z-50">
        <div class="flex items-center gap-3">
            <div class="w-9 h-9 rounded-xl flex items-center justify-center font-black text-sm"
                style="background: linear-gradient(135deg, #6366f1, #8b5cf6);">U</div>
            <span class="font-bold text-base tracking-tight">UserDash</span>
        </div>
        <a href="/read" class="flex items-center gap-2 text-zinc-400 hover:text-white text-sm font-medium transition-all border border-white/[0.07] hover:border-white/20 px-4 py-2 rounded-xl hover:bg-white/[0.04]">
            <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"/></svg>
            Back
        </a>
    </nav>

    <!-- Content -->
    <div class="relative z-10 flex items-center justify-center min-h-[calc(100vh-65px)] px-4 py-16">
        <div class="w-full max-w-md">

            <!-- Page title -->
            <div class="text-center mb-7 fade-up">
                <div class="editing-badge mb-4">
                    <span class="w-1.5 h-1.5 bg-purple-400 rounded-full animate-pulse"></span>
                    Editing User
                </div>
                <h1 class="text-3xl font-black tracking-tight">
                    Update
                    <span style="background: linear-gradient(135deg, #8b5cf6, #a78bfa, #6366f1); -webkit-background-clip: text; -webkit-text-fill-color: transparent; background-clip: text;">
                        Profile
                    </span>
                </h1>
            </div>

            <!-- Live Preview Card -->
            <div class="preview-card mb-5 fade-up d1">
                <div class="avatar-wrap">
                    <img id="preview-img"
                        src="<%= user.image %>"
                        alt="<%= user.name %>"
                        onerror="this.src='https://ui-avatars.com/api/?name=<%= encodeURIComponent(user.name) %>&background=8b5cf6&color=fff&bold=true&size=80'"
                        class="avatar-img">
                    <div class="online-dot"></div>
                </div>
                <div class="min-w-0 flex-1">
                    <p id="preview-name" class="font-bold text-base truncate"><%= user.name %></p>
                    <p id="preview-email" class="text-zinc-500 text-sm truncate mt-0.5"><%= user.email %></p>
                    <div class="flex items-center gap-1.5 mt-2">
                        <div class="w-1.5 h-1.5 bg-green-400 rounded-full"></div>
                        <span class="text-green-400 text-xs font-medium">Live preview</span>
                    </div>
                </div>
            </div>

            <!-- Form Card -->
            <div class="glass-card p-8 fade-up d2">
                <form action="/edit/<%= user._id %>" method="post" class="flex flex-col gap-5">

                    <div class="fade-up d2">
                        <label class="block text-[11px] font-bold text-zinc-500 uppercase tracking-widest mb-2">Full Name</label>
                        <div class="input-wrap">
                            <span class="input-icon">
                                <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"/></svg>
                            </span>
                            <input id="name-input" class="fancy-input" type="text" name="name" value="<%= user.name %>" required>
                        </div>
                    </div>

                    <div class="fade-up d3">
                        <label class="block text-[11px] font-bold text-zinc-500 uppercase tracking-widest mb-2">Email Address</label>
                        <div class="input-wrap">
                            <span class="input-icon">
                                <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/></svg>
                            </span>
                            <input id="email-input" class="fancy-input" type="email" name="email" value="<%= user.email %>" required>
                        </div>
                    </div>

                    <div class="fade-up d4">
                        <label class="block text-[11px] font-bold text-zinc-500 uppercase tracking-widest mb-2">Profile Image URL</label>
                        <div class="input-wrap">
                            <span class="input-icon">
                                <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z"/></svg>
                            </span>
                            <input id="img-url-input" class="fancy-input" type="text" name="imageurl" value="<%= user.image %>" required>
                        </div>
                    </div>

                    <div class="flex gap-3 mt-1 fade-up d4">
                        <a href="/read" class="btn-cancel">Cancel</a>
                        <button type="submit" class="btn-save">Save Changes →</button>
                    </div>

                </form>
            </div>

        </div>
    </div>

    <script>
        const imgInput = document.getElementById('img-url-input');
        const nameInput = document.getElementById('name-input');
        const emailInput = document.getElementById('email-input');
        const previewImg = document.getElementById('preview-img');
        const previewName = document.getElementById('preview-name');
        const previewEmail = document.getElementById('preview-email');

        imgInput.addEventListener('input', () => {
            if (imgInput.value.startsWith('http')) previewImg.src = imgInput.value;
        });
        nameInput.addEventListener('input', () => {
            previewName.textContent = nameInput.value || 'User Name';
        });
        emailInput.addEventListener('input', () => {
            previewEmail.textContent = emailInput.value || 'email@example.com';
        });
    </script>

</body>
</html>
